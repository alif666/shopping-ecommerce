{
  "info": {
    "_postman_id": "3b8d6e39-70a9-4d90-a364-305d1dd9582f",
    "name": "Grocery Items API",
    "description": "Requests for the Grocery Item filtering endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Find grocery item by exact name",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items/by-name/Rice",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items", "by-name", "Rice"]
        }
      }
    },
    {
      "name": "Find missing grocery item by name (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items/by-name/Milk",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items", "by-name", "Milk"]
        }
      }
    },
    {
      "name": "Get all grocery items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items"]
        }
      }
    },
    {
      "name": "Get grocery items by category",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items?category=grains",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items"],
          "query": [
            { "key": "category", "value": "grains" }
          ]
        }
      }
    },
    {
      "name": "Get grocery items by quantity range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items?minimumQuantity=5&maximumQuantity=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items"],
          "query": [
            { "key": "minimumQuantity", "value": "5" },
            { "key": "maximumQuantity", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Get grocery items by category and quantity range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items?category=grains&minimumQuantity=5&maximumQuantity=20&page=0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items"],
          "query": [
            { "key": "category", "value": "grains" },
            { "key": "minimumQuantity", "value": "5" },
            { "key": "maximumQuantity", "value": "20" },
            { "key": "page", "value": "0" }
          ]
        }
      }
    },
    {
      "name": "Get page two of grocery items",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/grocery-items?page=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "grocery-items"],
          "query": [
            { "key": "page", "value": "1" }
          ]
        }
      }
    }
  ]
}
